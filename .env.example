# MongoDB Atlas connection string (Atlas → Connect → Drivers). Copy to .env.local and add it in Vercel too.
# Secret: never share or commit.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# Database name (optional, default "school_portal").
MONGODB_DB=school_portal
# Public address of the site (used on QR codes and sign-in slips).
NEXT_PUBLIC_SITE_URL=https://anatomy-six-beta.vercel.app
