# Supabase project (Project Settings → API). Copy to .env.local and add the same values in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only, never share or commit.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the site (used on QR codes and sign-in slips).
NEXT_PUBLIC_SITE_URL=https://anatomy-six-beta.vercel.app
